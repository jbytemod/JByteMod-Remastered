	<artifactId>jbytemod-core</artifactId>
	<name>JByteMod Core</name>
	<packaging>jar</packaging>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<asm.version>9.10-SNAPSHOT</asm.version>
		<procyon.version>0.6.0</procyon.version>
		<cfr.version>master</cfr.version>
		<cfr.ide.version>0.152</cfr.ide.version>
		<cfr.source.root>${project.build.directory}/cfr-source</cfr.source.root>
		<cfr.version.source>${project.build.directory}/generated-sources/cfr-version</cfr.version.source>
		<jd-core.version>1.1.3</jd-core.version>
		<vineflower.version>1.12.0</vineflower.version>
		<koffee.version>1.0.2</koffee.version>
		<r8.version>9.4.17</r8.version>
		<apksig.version>9.4.0</apksig.version>
	</properties>


